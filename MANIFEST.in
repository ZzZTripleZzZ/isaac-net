# Source distribution: the package, its data, the full test suite and the top-level documents.
# Benchmarks, results, the docs site sources and the Windows / HPC scripts stay in the repository only.
include LICENSE README.md CHANGELOG.md ARCHITECTURE.md CONTRIBUTING.md RELEASE.md
recursive-include tests *.py *.md *.log *.txt *.csv *.jsonl *.sh
recursive-exclude * __pycache__ *.py[cod] *.so *.pt *.ckpt *lena_eesm_tables*
